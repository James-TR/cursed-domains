{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cursed-domains",
  "compatibility_date": "2026-04-07",
  "observability": {
    "enabled": true
  },
  "main": "src/index.js",
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
